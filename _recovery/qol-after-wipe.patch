+const runSummary = {
+  active: false,
+  started: 0,
+  ok: 0,
+  charged: 0,
+  cart: 0,
+  proxyFail: 0,
+  otherFail: 0,
+  timer: null,
+};
+
+function bumpRunSummaryStart(n = 1) {
+  runSummary.active = true;
+  runSummary.started += Math.max(1, Number(n) || 1);
+  scheduleRunSummaryRender();
+}
+
+function bumpRunSummaryDone(evt) {
+  if (!runSummary.active && !runSummary.started) {
+    runSummary.active = true;
+    runSummary.started = 1;
+  }
+  const code = String(evt?.consumerCode || evt?.lastStatus || "").toLowerCase();
+  const label = String(evt?.consumerLabel || evt?.error || "").toLowerCase();
+  if (evt?.ok) {
+    runSummary.ok += 1;
+    if (evt.orderNumber || code === "confirmed") runSummary.charged += 1;
+    else if (code === "cart_held" || /cart|atc|held/.test(label)) runSummary.cart += 1;
+  } else {
+    if (/proxy|soft.?block|tunnel|econn|timeout|403/.test(`${code} ${label}`)) {
+      runSummary.proxyFail += 1;
+    } else {
+      runSummary.otherFail += 1;
+    }
+  }
+  scheduleRunSummaryRender();
+}
+
+function scheduleRunSummaryRender() {
+  if (runSummary.timer) clearTimeout(runSummary.timer);
+  runSummary.timer = setTimeout(() => renderRunSummary(), 200);
+}
+
+function renderRunSummary() {
+  const card = $("runSummaryCard");
+  const line = $("runSummaryLine");
+  if (!card || !line) return;
+  if (!runSummary.active && !runSummary.started) {
+    card.hidden = true;
+    return;
+  }
+  card.hidden = false;
+  const fail = runSummary.proxyFail + runSummary.otherFail;
+  const bits = [
+    `${runSummary.started} started`,
+    `${runSummary.ok} ok`,
+    `${runSummary.cart} cart`,
+    `${runSummary.charged} charged`,
+    `${runSummary.proxyFail} proxy fail`,
+  ];
+  if (runSummary.otherFail) bits.push(`${runSummary.otherFail} other fail`);
+  line.textContent = bits.join(" ┬╖ ");
+  line.classList.toggle("ok", runSummary.ok > 0 && fail === 0);
+  line.classList.toggle("bad", fail > 0 && runSummary.ok === 0);
+}
+
+function clearRunSummary() {
+  runSummary.active = false;
+  runSummary.started = 0;
+  runSummary.ok = 0;
+  runSummary.charged = 0;
+  runSummary.cart = 0;
+  runSummary.proxyFail = 0;
+  runSummary.otherFail = 0;
+  if (runSummary.timer) clearTimeout(runSummary.timer);
+  runSummary.timer = null;
+  renderRunSummary();
+}
 
